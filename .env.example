# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Public site URL ----
# The production domain customers will reach, e.g. https://brewandshot.cafe
# Used as the default destination for the review QR code ( /reviews/submit ).
# Admins can override the QR destination later from /admin/qr without redeploying.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Random secret used to hash visitor IPs for rate limiting (any long random string)
RATE_LIMIT_SALT=change-me-to-a-long-random-string
